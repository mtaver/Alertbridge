# Public browser credentials from Supabase Project Settings → API.
# Never put a service-role key here or in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional public, URL-restricted Mapbox token for explicit place searches.
# Search text is sent to Mapbox only when the user selects Search.
VITE_MAPBOX_ACCESS_TOKEN=your-public-mapbox-token
