# Public browser credentials from Supabase Project Settings → API.
# Never put a service-role key here or in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional public, URL-restricted Mapbox token for explicit place searches.
# Search text is sent to Mapbox only when the user selects Search.
VITE_MAPBOX_ACCESS_TOKEN=your-public-mapbox-token

# Public VAPID key only. This value is intentionally exposed to browsers.
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server-only Vercel Function settings. Never prefix these with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-server-only-vapid-private-key
VAPID_SUBJECT=mailto:your-contact@example.com
# Also store this value in Supabase Vault as alertbridge_push_worker_secret.
CRON_SECRET=your-long-random-server-only-secret
